NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hostelhub
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_URL=http://localhost:5173,http://localhost:5174
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
DNS_SERVERS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional for local demo seeding; defaults to Password123! in development.
SEED_PASSWORD=
# Optional: owner phone verification by SMS (Twilio Verify). When all three are set,
# owners must verify their mobile number before submitting a listing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
